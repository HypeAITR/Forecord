<Window x:Class="ScreenRecorder.Views.RecordingCompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıt Tamamlandı"
        Width="360" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Fade + small TranslateX enter animation. -->
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetName="ToastRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="ToastTranslate"
                             Storyboard.TargetProperty="X"
                             From="28" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Fade + small left drift on close. -->
        <Storyboard x:Key="SlideOut" Completed="SlideOut_Completed">
            <DoubleAnimation Storyboard.TargetName="ToastRoot"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ToastTranslate"
                             Storyboard.TargetProperty="X"
                             To="-18" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideIn}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="ToastRoot"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Opacity="0"
            MouseEnter="Toast_MouseEnter"
            MouseLeave="Toast_MouseLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTranslate" X="28"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- İkon (kayıt için yeşil ✓, ekran görüntüsü için mavi 📸) -->
            <Border x:Name="IconBadge"
                    Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Background="{StaticResource AccentGreenBrush}"
                    VerticalAlignment="Top"
                    Margin="0,2,12,0">
                <TextBlock x:Name="IconText"
                           Text="✓" FontSize="20" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Başlık -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0" Grid.Column="1"
                       Text="Kayıt Tamamlandı"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>

            <!-- Dosya adı -->
            <TextBlock Grid.Row="1" Grid.Column="1"
                       x:Name="FileNameText"
                       FontSize="11"
                       Foreground="{StaticResource SubTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0"/>

            <!-- Kapat (×) butonu -->
            <Button Grid.Row="0" Grid.Column="2"
                    Content="✕"
                    Style="{StaticResource FlatButton}"
                    Background="Transparent"
                    Foreground="{StaticResource SubTextBrush}"
                    FontSize="11" Padding="6,2"
                    Click="Close_Click"/>

            <!-- Aksiyon butonları -->
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Dosyayı Aç"
                        Style="{StaticResource FlatButton}"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White"
                        Padding="14,6" FontSize="12"
                        Click="OpenFile_Click"
                        Margin="0,0,6,0"/>
                <Button Content="Klasörde Göster"
                        Style="{StaticResource FlatButton}"
                        Padding="14,6" FontSize="12"
                        Click="ShowFolder_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
