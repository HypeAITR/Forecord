<UserControl x:Class="ScreenRecorder.Views.Background.LayeredBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:effects="clr-namespace:ScreenRecorder.Effects"
             ClipToBounds="True"
             IsHitTestVisible="False">

    <Grid Background="#FF181819">

        <!-- Reactive surface: shader displaces this entire stack around the cursor -->
        <Grid x:Name="ReactiveSurface">
            <Grid.Effect>
                <effects:CursorDisplacementEffect x:Name="CursorDisplacement"
                                                  Radius="0.16"
                                                  Strength="0"/>
            </Grid.Effect>

            <!-- Very subtle vertical tonal shift, charcoal -> slightly deeper charcoal -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF1C1C1E" Offset="0"/>
                        <GradientStop Color="#FF171718" Offset="0.55"/>
                        <GradientStop Color="#FF131314" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Micro grain: tiled tiny dots, very low alpha -->
            <Rectangle Opacity="0.04">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,5,5"
                                  ViewportUnits="Absolute"
                                  Stretch="None">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#80FFFFFF"
                                                 Geometry="M0,0 L1,0 1,1 0,1Z"/>
                                <GeometryDrawing Brush="#30FFFFFF"
                                                 Geometry="M3,2 L4,2 4,3 3,3Z"/>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

        </Grid>
    </Grid>
</UserControl>
