<Window x:Class="ScreenRecorder.Views.FloatingPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıt Kontrol"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- İki ayrı pill: ana kontroller + ayrık kalem podu. Aralarında 8px boşluk. -->
    <StackPanel Orientation="Horizontal">
    <Border Background="#F01C1C1E"
            Height="52"
            MinWidth="406"
            CornerRadius="22"
            BorderBrush="#33FFFFFF"
            BorderThickness="0.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="14,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- nabız noktası -->
                <ColumnDefinition Width="Auto"/>  <!-- süre -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>  <!-- mikrofon -->
                <ColumnDefinition Width="Auto"/>  <!-- ekran görüntüsü -->
                <ColumnDefinition Width="Auto"/>  <!-- duraklat -->
                <ColumnDefinition Width="Auto"/>  <!-- sil (çöp kutusu) -->
                <ColumnDefinition Width="Auto"/>  <!-- durdur -->
            </Grid.ColumnDefinitions>

            <!-- Nabız atan kayıt noktası -->
            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#FFFF453A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Fill" Value="#FFFF9F0A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="PulseFloat">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.3" Duration="0:0:0.8"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseFloat"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- Süre sayacı -->
            <TextBlock Grid.Column="1"
                       Text="{Binding TimerText}"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="15" FontWeight="Medium"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <!-- Mikrofon toggle -->
            <ToggleButton Grid.Column="3"
                          IsChecked="{Binding MicEnabled}"
                          Width="34" Height="34"
                          Background="#1AFFFFFF"
                          BorderThickness="0"
                          Cursor="Hand"
                          ToolTip="Mikrofon">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <TextBlock x:Name="Ico" Text="🎤"
                                       FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ico" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd"  Property="Background" Value="#3332D74B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!-- Ekran görüntüsü (kayıt sırasında) -->
            <Button Grid.Column="4"
                    Command="{Binding ScreenshotCommand}"
                    Width="34" Height="34"
                    Background="#1AFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="2,0,0,0"
                    ToolTip="Ekran görüntüsü al">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <TextBlock x:Name="Ico" Text="📸"
                                       FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.85"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="Ico" Property="Opacity"    Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Duraklat / Devam Et -->
            <Button Grid.Column="5"
                    Command="{Binding PauseResumeCommand}"
                    Width="34" Height="34"
                    Background="#1AFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="2,0,0,0"
                    ToolTip="Duraklat / Devam Et">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <TextBlock x:Name="Ico"
                                       FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏸"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Sil / İptal (çöp kutusu) -->
            <Button Grid.Column="6"
                    Command="{Binding DiscardCommand}"
                    Width="34" Height="34"
                    Background="#1AFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="2,0,0,0"
                    ToolTip="Kaydı sil">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <TextBlock x:Name="Ico" Text="🗑"
                                       FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.85"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#33FF453A"/>
                                <Setter TargetName="Ico" Property="Opacity"    Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Durdur (kırmızı kare) -->
            <Button Grid.Column="7"
                    Command="{Binding StartStopCommand}"
                    Width="36" Height="36"
                    Background="#FFFF453A"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="4,0,0,0"
                    ToolTip="Kaydı Durdur">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <Rectangle Width="11" Height="11"
                                       Fill="White" RadiusX="2" RadiusY="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
    </Border>

    <!-- Ayrık kalem podu — ana pill ile arasında 8px boşluk; aynı arka plan
         dili ama görsel olarak kopuk: kullanıcı burada ayrı bir grup olduğunu
         hissetsin. -->
    <Border Background="#F01C1C1E"
            Height="52"
            CornerRadius="26"
            BorderBrush="#33FFFFFF"
            BorderThickness="0.5"
            Margin="8,0,0,0"
            Padding="9,0"
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <ToggleButton IsChecked="{Binding IsAnnotationOpen, Mode=OneWay}"
                      Command="{Binding ToggleAnnotationCommand}"
                      Width="34" Height="34"
                      Background="#1AFFFFFF"
                      BorderThickness="0"
                      Cursor="Hand"
                      VerticalAlignment="Center"
                      ToolTip="Çizim araçları">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="17">
                        <TextBlock x:Name="Ico" Text="✎"
                                   FontSize="15"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.85"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd"  Property="Background" Value="#22FFFFFF"/>
                            <Setter TargetName="Ico" Property="Opacity"    Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd"  Property="Background" Value="#FFFF453A"/>
                            <Setter TargetName="Ico" Property="Opacity"    Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Border>
    </StackPanel>
</Window>
